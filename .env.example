# Keep localhost when using SSH or Tailscale Serve.
HOST=127.0.0.1
PORT=3000

# Directory used by the first Pi session. Defaults to this project.
PI_CWD=/home/your-user
PI_COMMAND=pi

# Directories allowed in the workspace picker. On Linux/macOS, separate with ':'.
# The configured roots and their immediate child directories are listed in the UI.
FRIDAY_WORKSPACE_ROOTS=/home/your-user
